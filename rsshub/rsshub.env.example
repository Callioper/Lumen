# Copy to rsshub.env next to server.mjs. Every line is optional; a route that needs a login it
# does not have simply fails, and Lumen shows that feed as erroring.

# 豆瓣: some routes (friends' broadcasts) need a logged-in cookie containing dbcl2 and ck.
# DOUBAN_COOKIE=

# A proxy, used only for the sites PROXY_URL_REGEX matches; everything else goes direct.
# PROXY_URI=http://127.0.0.1:7890
# PROXY_URL_REGEX=(twitter\.com|x\.com|youtube\.com|t\.me)

# B站: a logged-in cookie (SESSDATA, bili_jct, DedeUserID …) for the routes that ask for one,
# named after your own user id.
# BILIBILI_COOKIE_<uid>=
